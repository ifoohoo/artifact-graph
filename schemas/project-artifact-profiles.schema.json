{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://artifact-graph.dev/schemas/project-artifact-profiles/v1.0.schema.json",
  "title": "Project Artifact Profiles",
  "description": "随包发布的项目制品类型推荐清单契约（schema_version 固定为 1.0），定义跨项目最小集合、已批准项目形态标准、采用阶段候选与能力触发候选；仅作为裁剪参考，读取该清单不会自动启用目标项目类型。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "common_minimum", "project_standards", "lifecycle", "conditional"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "推荐清单契约版本号，当前 Schema 固定为 \"1.0\"。"
    },
    "common_minimum": {
      "type": "array",
      "description": "跨项目通用的最小制品类型名称集合（去重且不会在运行时自动启用）。",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "project_standards": {
      "type": "object",
      "description": "已批准的项目形态标准扩展映射，当前仅包含 skill-plugin 这一独立品类标准。",
      "additionalProperties": false,
      "properties": {
        "skill-plugin": {
          "$ref": "#/$defs/projectStandard"
        }
      }
    },
    "lifecycle": {
      "type": "array",
      "description": "按采用阶段触发的候选制品类型列表；condition 供引导技能理解判读，不包含运行时条件求值器。",
      "items": {
        "$ref": "#/$defs/lifecycleEntry"
      }
    },
    "conditional": {
      "type": "array",
      "description": "按项目形态与具体能力特征按需纳入的候选制品类型列表，默认不自动启用。",
      "items": {
        "$ref": "#/$defs/conditionalEntry"
      }
    }
  },
  "$defs": {
    "artifactTypeName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "projectStandard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extends", "additional_types"],
      "properties": {
        "extends": {
          "type": "string",
          "const": "common_minimum"
        },
        "additional_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactTypeName"
          }
        }
      }
    },
    "lifecycleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "adoption_stages", "condition"],
      "properties": {
        "type": {
          "$ref": "#/$defs/artifactTypeName"
        },
        "adoption_stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["initial", "legacy-backfill", "daily-iteration"]
          }
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conditionalEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "project_shapes", "condition"],
      "properties": {
        "type": {
          "$ref": "#/$defs/artifactTypeName"
        },
        "project_shapes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["cli-library", "web", "desktop", "skill-plugin"]
          }
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
