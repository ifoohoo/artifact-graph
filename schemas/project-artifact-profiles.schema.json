{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://artifact-graph.dev/schemas/project-artifact-profiles/v1.0.schema.json",
  "title": "Project Artifact Profiles",
  "description": "Static published lists of common-minimum, project-type standard, lifecycle, and capability-triggered artifact types. schema_version must be 1.0. This file is a recommendation contract; reading it does not enable project types.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "common_minimum", "project_standards", "lifecycle", "conditional"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Contract version. Must be '1.0' for this schema."
    },
    "common_minimum": {
      "type": "array",
      "description": "Cross-project common minimum artifact types. Unique names; not auto-enabled.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "project_standards": {
      "type": "object",
      "description": "Approved project-shape standards. Only skill-plugin is currently an independent category standard.",
      "additionalProperties": false,
      "properties": {
        "skill-plugin": {
          "$ref": "#/$defs/projectStandard"
        }
      }
    },
    "lifecycle": {
      "type": "array",
      "description": "Stage-triggered candidates. condition is for skill interpretation; no runtime condition interpreter is implied.",
      "items": {
        "$ref": "#/$defs/lifecycleEntry"
      }
    },
    "conditional": {
      "type": "array",
      "description": "Capability-triggered candidates for matching project shapes. Not auto-enabled.",
      "items": {
        "$ref": "#/$defs/conditionalEntry"
      }
    }
  },
  "$defs": {
    "artifactTypeName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "projectStandard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extends", "additional_types"],
      "properties": {
        "extends": {
          "type": "string",
          "const": "common_minimum"
        },
        "additional_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactTypeName"
          }
        }
      }
    },
    "lifecycleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "adoption_stages", "condition"],
      "properties": {
        "type": {
          "$ref": "#/$defs/artifactTypeName"
        },
        "adoption_stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["initial", "legacy-backfill", "daily-iteration"]
          }
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conditionalEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "project_shapes", "condition"],
      "properties": {
        "type": {
          "$ref": "#/$defs/artifactTypeName"
        },
        "project_shapes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["cli-library", "web", "desktop", "skill-plugin"]
          }
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
